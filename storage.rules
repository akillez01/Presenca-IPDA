rules_version = '2';

// Firebase Storage Security Rules
service firebase.storage {
  match /b/{bucket}/o {
    // E-mails da equipe autorizada a consultar/gerenciar arquivos sensíveis
    // (mesma lista usada nas regras do Firestore de produção)
    function isAuthorizedStaff() {
      return request.auth != null && request.auth.token.email in [
        'admin@ipda.org.br', 'marciodesk@ipda.app.br',
        'presente@ipda.app.br', 'secretaria@ipda.org.br', 'auxiliar@ipda.org.br', 'cadastro@ipda.app.br',
        'registro1@ipda.app.br', 'registro2@ipda.app.br', 'registro3@ipda.app.br', 'registro4@ipda.app.br'
      ];
    }

    // Regra para fotos de presença - permite upload/leitura/exclusão autenticada
    match /attendance-photos/{fileName} {
      // Permite leitura para usuários autenticados
      allow read: if request.auth != null;
      
      // Permite upload para usuários autenticados
      allow create, update: if request.auth != null
                            && request.resource.size < 2 * 1024 * 1024  // Máximo 2MB (já comprimido)
                            && request.resource.contentType.matches('image/.*');  // Apenas imagens
      
      // Permite exclusão para usuários autenticados
      allow delete: if request.auth != null;
    }

    // Regra para arquivos de batismo (foto 3x4 + documentos em imagem/PDF).
    // Cadastro público (/cadastro-batismo, sem login) faz upload direto aqui
    // desde a mudança "Cadastro de batismo direto" — por isso "create" é aberto,
    // igual ao padrão já usado em batismo-pending-files. Leitura/edição/exclusão
    // continuam exigindo login da equipe.
    match /batismo-files/{recordId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.resource.size < 10 * 1024 * 1024
                       && (
                         request.resource.contentType.matches('image/.*') ||
                         request.resource.contentType == 'application/pdf'
                       );
      allow update: if request.auth != null
                            && request.resource.size < 10 * 1024 * 1024
                            && (
                              request.resource.contentType.matches('image/.*') ||
                              request.resource.contentType == 'application/pdf'
                            );
      allow delete: if request.auth != null;
    }
    
    // Regra para arquivos enviados pelo link público de cadastro de batismo (sem login).
    // Upload é aberto (sem autenticação), mas leitura/edição/exclusão exige login —
    // só a equipe consegue ver ou baixar o que foi enviado.
    match /batismo-pending-files/{recordId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create: if request.resource.size < 10 * 1024 * 1024
                       && (
                         request.resource.contentType.matches('image/.*') ||
                         request.resource.contentType == 'application/pdf'
                       );
      allow update, delete: if request.auth != null;
    }

    // Regra para arquivos da Sede Estadual (foto 3x4)
    // Cadastro é feito só pelo painel administrativo, por isso todo acesso exige equipe autorizada.
    match /sede-estadual-files/{recordId}/{allPaths=**} {
      allow read: if isAuthorizedStaff();
      allow create, update: if isAuthorizedStaff()
                            && request.resource.size < 10 * 1024 * 1024
                            && request.resource.contentType.matches('image/.*');
      allow delete: if isAuthorizedStaff();
    }

    // Regra padrão - bloqueia tudo que não corresponder às regras acima
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
